# Upstream model endpoints (OpenAI-compatible). Copy to .env.api (git-ignored, chmod 600).
# Only the model gateway process reads this file; configs/gateway.yaml names the variables.
# More endpoints follow the same numbering: RS_GW_EP3_URL / RS_GW_EP3_KEY, and so on.

RS_GW_EP1_URL=https://provider-a.example.com/v1
RS_GW_EP1_KEY=sk-placeholder
RS_GW_EP2_URL=https://provider-b.example.com/v1
RS_GW_EP2_KEY=sk-placeholder
