# Local paths and tokens. Copy to .env (git-ignored, chmod 600) and fill in.

# Blob store directory shared by the services (a stack sets it for its own services).
RS_BLOB_DIR=/path/to/blobs
# RS_RUNS_ROOT=/fast/disk/rs-runs   (optional: where relative runs/... directories live)
# Bearer token that local clients present to the model gateway.
RS_GATEWAY_TOKEN=change-me
# Bearer token of the gateway's admin plane, where a Hub registers its episodes for permits.
# Brains get RS_GATEWAY_TOKEN, never this one. Use 16 or more random characters.
RS_GATEWAY_ADMIN_TOKEN=change-me
# Secret of the tool hub (32 or more random characters): its token keys and its control token
# are derived from it.
RS_HUB_SECRET=change-me
# For remote toolset servers only: the key they verify the Hub's service tokens with,
# roboscript.hub.tokens.service_key(RS_HUB_SECRET). It opens nothing else.
RS_HUB_SERVICE_KEY=change-me
# Bearer token of the env servers' control plane (env.control), held by the orchestrator.
RS_ENV_TOKEN=change-me
# Bearer token of the Agent host (agent.host), shared with the evaluation policy module in a
# benchmark's policy server. The evaluation launcher issues one per run in the environment instead.
RS_HOST_TOKEN=change-me

# Benchmark variables: each benchmark's adapter declares its own and reads them through
# roboscript.settings.path_variable. Set those of the benchmarks you use.

# roboscript_robotwin.config: the RoboTwin checkout used by the simulator side, and the expert
# demonstrations (<task>/<task config>/data/episode<N>.hdf5).
ROBOTWIN_ROOT=/path/to/RoboTwin
RS_EXPERT_DEMO_ROOT=/path/to/expert_demo
